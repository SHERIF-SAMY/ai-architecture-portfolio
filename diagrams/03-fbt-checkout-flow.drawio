<mxfile host="app.diagrams.net"><diagram name="FBT at checkout" id="fbt"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1690" pageHeight="1110"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c101" value="Use case: “Frequently bought together” at checkout — sequence view (Option A: precomputed top-K)" style="text;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c102" value="" style="rounded=1;arcSize=2;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="10" y="150" width="1670" height="490" as="geometry"/></mxCell><mxCell id="c103" value="A. Real-time request path  (P95 target 500 ms page; this flow ≈ 250 ms worst case)" style="text;fontSize=14;fontStyle=1;fontColor=#1f5fbf;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="154" width="1000" height="24" as="geometry"/></mxCell><mxCell id="c104" value="" style="rounded=1;arcSize=2;fillColor=#f3f9f0;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="10" y="665" width="1670" height="345" as="geometry"/></mxCell><mxCell id="c105" value="B. Background path: streaming ingestion (orange) + nightly batch (green) — never on the customer’s request" style="text;fontSize=14;fontStyle=1;fontColor=#3a8a3a;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="669" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c106" value="Customer&lt;br&gt;(Web / App)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="29.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c107" value="API Gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="179.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c108" value="E-commerce&lt;br&gt;service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="329.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c109" value="Operational DB&lt;br&gt;(OLTP)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="479.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c110" value="Recommendation&lt;br&gt;engine" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="629.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c111" value="Feature store&lt;br&gt;(offline + online)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="779.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c112" value="Vector DB&lt;br&gt;(batch only, v2)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="929.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c113" value="CDC → Kafka&lt;br&gt;→ Flink" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="1079.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c114" value="CDP&lt;br&gt;(OLAP)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="1229.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c115" value="Airflow&lt;br&gt;(nightly)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="1379.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c116" value="WhatsApp&lt;br&gt;(not used)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=56;fillColor=#eeeeee;strokeColor=#bbbbbb;fontStyle=1;fontSize=13;rounded=1;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1529.0" y="70" width="132" height="940" as="geometry"/></mxCell><mxCell id="c117" value="1. Open checkout  [≤50 ms]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="205" as="sourcePoint"/><mxPoint x="245" y="205" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c118" value="2. Auth + route  [≤10 ms]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="245" as="sourcePoint"/><mxPoint x="395" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c119" value="3. Load cart + prices  [≤80 ms]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="285" as="sourcePoint"/><mxPoint x="545" y="285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c120" value="4. GET /fbt?items=…  (in parallel with 3, timeout 120 ms)  [≤5 ms]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="330" as="sourcePoint"/><mxPoint x="695" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c121" value="5. Read fbt_top10 per cart item  [≤10 ms]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="375" as="sourcePoint"/><mxPoint x="845" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c122" value="6. Merge, drop items already in cart, top 4  [≤15 ms]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="410" as="sourcePoint"/><mxPoint x="695" y="436" as="targetPoint"/><Array as="points"><mxPoint x="740" y="410"/><mxPoint x="740" y="436"/></Array></mxGeometry></mxCell><mxCell id="c123" value="7. 4 product ids  (timeout → category best-sellers)  [≤5 ms]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="465" as="sourcePoint"/><mxPoint x="395" y="465" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c124" value="8. Price + stock for 4 ids (1 PK query)  [≤20 ms]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="505" as="sourcePoint"/><mxPoint x="545" y="505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c125" value="9. Cart page + “Frequently bought together” widget  [≤50 ms]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="550" as="sourcePoint"/><mxPoint x="95" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c126" value="10. Impression / click / add-to-cart events (async)  ← MISSING in HLA: event tracking" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#cc0000;fontColor=#cc0000;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="600" as="sourcePoint"/><mxPoint x="1145" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c127" value="B1. Order rows captured by Debezium CDC  (continuous)" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d07a00;fontColor=#d07a00;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="715" as="sourcePoint"/><mxPoint x="1145" y="715" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c128" value="B2. Clean orders  [minutes]" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d07a00;fontColor=#d07a00;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="755" as="sourcePoint"/><mxPoint x="1295" y="755" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c129" value="B3. 02:00 read last 90 days orders" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a8a3a;fontColor=#3a8a3a;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="800" as="sourcePoint"/><mxPoint x="1295" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c130" value="B4. Co-purchase pairs: lift + confidence → top 10 / item" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a8a3a;fontColor=#3a8a3a;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=right;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="835" as="sourcePoint"/><mxPoint x="1445" y="861" as="targetPoint"/><Array as="points"><mxPoint x="1400" y="835"/><mxPoint x="1400" y="861"/></Array></mxGeometry></mxCell><mxCell id="c131" value="B5. (v2) items with few orders → borrow lists of similar items" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a8a3a;fontColor=#3a8a3a;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="900" as="sourcePoint"/><mxPoint x="995" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c132" value="B6. Write offline + materialise online (fbt_top10, fallback lists)" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a8a3a;fontColor=#3a8a3a;fontStyle=1;fontSize=12;labelBackgroundColor=none;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="945" as="sourcePoint"/><mxPoint x="845" y="945" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c133" value="&lt;b&gt;Legend&lt;/b&gt;: blue = real-time request · orange = streaming ingestion · green = batch (Airflow) · dashed = response / fallback / optional · red = missing from HLA&lt;br&gt;[≤ N ms] = P95 budget per hop. Critical path 1→2→max(3, 4–7)→8→9 = 50+10+120+20+50 = 250 ms &amp;lt; 500 ms P95 SLO. Operational DB load from recommendations: one 4-row PK lookup (step 8).&lt;br&gt;Not used: WhatsApp, Vector DB on the request path, any LLM. Flink only cleans/lands orders already flowing to the CDP." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="1650" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
